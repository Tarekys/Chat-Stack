DATABASE_URL = "**********"

OPENAI_API_KEY = "**********"
GROQ_API_KEY = "**********"
BASE_URL = "https://api.groq.com/openai/v1"

LIST_OF_GENERATION_MODEL = ["qwen/qwen3.8-27b", "gpt-4o", "GPT-5"]
OPENAI_MODEL_ID = "gpt-4o"
GROQ_MODEL_ID = "qwen/qwen3.8-27b"

# AI Backend Configuration
LIST_OF_AI_BACKEND = ["GROQ", "OPENAI"]
